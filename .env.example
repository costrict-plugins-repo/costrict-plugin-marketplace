# GitHub PAT or App token with scope to create + push repos under costrict-plugins-repo org.
# Used only by `scripts/build.py --publish` and `scripts/release.sh`.
# Copy to .env (gitignored) and fill in.
GITHUB_TOKEN=

# Local catalog checkout, used by build.py to read plugin metadata.
# Defaults to ../costrict-skills-repo if unset.
COSTRICT_SKILLS_REPO_PATH=../costrict-skills-repo

# GitHub org for plugin mirroring.
GITHUB_ORG=costrict-plugins-repo
